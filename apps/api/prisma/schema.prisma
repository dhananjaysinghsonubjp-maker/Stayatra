// Foundation schema for the hotel platform (MASTER_SPEC.md §5, §8).
// Scope matches the agreed hotel #1 launch bar: Channel Manager core + shared
// bookings/payments + PMS rooms/check-in/housekeeping/audit. Guest messaging
// (§5.2's guest_messages, Phase 2) and theft-protection-specific
// reconciliation logic (§8.7) are still deliberately deferred — see
// memory/hotel_platform_build_plan.md. Billing (§5.4) now has a real, simple
// version: SubscriptionPlan/Subscription below, with the actual gateway call
// stubbed (no Razorpay credentials exist yet) — same swap-later pattern as
// id-extraction's StubIdExtractor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── §5.5 Organizations, modules, users ──────────────────────────────────────

enum ModuleType {
  channel_manager
  pms
  theft_protection
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  planTier  String?  @map("plan_tier")
  // platform-admin kill switch for a tenant — separate from billing state
  // (below); this is a manual ops action, not a payment lapse.
  suspended Boolean  @default(false)
  // §5.5 — set by a platform admin assigning this tenant to a reseller/
  // white-label partner; null means it came in direct. Only tracking today
  // (name + tag), no commission payout math — that's derived from billing
  // (below) × Affiliate.commissionRate, not built yet.
  referredByAffiliateId String? @map("referred_by_affiliate_id")
  createdAt DateTime @default(now()) @map("created_at")

  modules      OrganizationModule[]
  users        User[]
  hotels       Hotel[]
  affiliate    Affiliate?           @relation(fields: [referredByAffiliateId], references: [id])
  subscription Subscription?

  @@map("organizations")
}

// §5.4 catalog — what's actually for sale. Seeded once at API boot
// (see PlansService), editable afterward from Super Admin. `modules` is the
// set of ModuleType this plan grants on purchase — the one place plan
// selection turns into real OrganizationModule rows.
model SubscriptionPlan {
  id            String       @id @default(cuid())
  key           String       @unique // stable slug used by the signup UI, e.g. "cm_pms_theft"
  name          String
  description   String
  modules       ModuleType[]
  priceMonthly  Decimal      @map("price_monthly") @db.Decimal(10, 2) // placeholder pricing — edit for real numbers later
  createdAt     DateTime     @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// §5.4, simplified: one active subscription per organization. The actual
// gateway call is stubbed (StubPaymentGateway — no Razorpay credentials
// exist yet); "buying" a plan activates it immediately rather than routing
// through a real charge. `gatewayReference` stays null until a real gateway
// is wired in, at which point it'd point at that gateway's own subscription
// object, same as the spec's original design.
model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique @map("organization_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(active)
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  gatewayReference   String?            @map("gateway_reference")
  createdAt          DateTime           @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  locked
  cancelled
}

// A reseller/white-label partner (§5.5). Gets a scoped, re-skinned copy of
// the Super Admin console — same capabilities (module entitlements, suspend/
// reactivate), but only ever sees organizations it referred, never the whole
// platform. `brandName`/`logoUrl`/`primaryColor` re-skin that portal's own
// chrome; this does NOT change how any individual hotel's PMS looks — the
// spec is explicit that white-label only re-skins the partner's own console,
// not each downstream hotel's product. No self-registration — a platform
// admin creates every affiliate account, mirroring how hotel staff and
// platform admins themselves are onboarded (never a public signup form).
model Affiliate {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  // tracking only for now — % of what the hotel pays us, once billing (§5.4)
  // exists to compute an actual payout from. Not used for math yet.
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  brandName      String?  @map("brand_name")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color") // hex, e.g. "#4f46e5" — the one color this partner's portal is themed with
  createdAt      DateTime @default(now()) @map("created_at")

  organizations Organization[]
  sessions      Session[]

  @@map("affiliates")
}

// A platform operator — manages every tenant organization, not scoped to any
// one of them. Deliberately its own model rather than a flag on `User`: a
// `User` always belongs to exactly one Organization (§5.5), which is the wrong
// shape for someone who oversees all of them. No self-registration, same as
// hotel staff (§8.2) — the first row is created by a one-off ops script, not
// a public endpoint (see apps/api/scripts/create-platform-admin.mjs).
model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@map("platform_admins")
}

// enforces §5.5's rule: theft_protection can only be enabled if pms is also
// enabled for the same organization — enforced at the application layer
// (see modules service), not just here.
model OrganizationModule {
  organizationId String     @map("organization_id")
  module         ModuleType
  enabled        Boolean    @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, module])
  @@map("organization_modules")
}

model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  // email+password (§3) is only for signup and as a fallback to set a PIN in the first
  // place — day-to-day login for everyone (owner, manager, front desk, housekeeping) is
  // now the universal Property ID + role + PIN flow (§ user request), so both fields below
  // can be populated together on the same user — no longer "exactly one path populated".
  email          String?  @unique
  passwordHash   String?  @map("password_hash")
  hotelId        String?  @map("hotel_id") // null only until the owner's hotel exists or a PIN is first set (see setMyPin)
  pinHash        String?  @map("pin_hash") // bcrypt; unique only within a hotel, checked at write time (§8.1)
  createdAt      DateTime @default(now()) @map("created_at")

  // §user request — a full staff profile, not just a name+PIN. A GM/FMO (front_desk) can
  // *propose* one of these for housekeeping/front-desk staff, but only an owner can approve it
  // and mint the PIN — proposed profiles sit with pinHash still null until then.
  phone              String?             @map("phone")
  photoPath          String?             @map("photo_path")
  idType             IdType?             @map("id_type")
  idNumber           String?             @map("id_number")
  // §user request — "Aadhaar front and back dono upload karte hain, owner dashboard mein ek
  // printable page mein dono saath dikhein": a single idPhotoPath couldn't hold both sides.
  // Replaces it (migration carries any existing value into idPhotoFrontPath, nothing lost).
  idPhotoFrontPath   String?             @map("id_photo_front_path")
  idPhotoBackPath    String?             @map("id_photo_back_path")
  // §user request — "General Manager" / "Front Office Manager" as two job-title choices a hotel
  // can pick between, both carrying the same front_desk permission level underneath (confirmed:
  // not two different access tiers). Free text so it degrades gracefully for anything older.
  designation        String?             @map("designation")
  // §user request — which shift a housekeeping staff member works (Morning/Evening/Night).
  // Free text, same pattern as designation — only meaningful for housekeeping role staff.
  shift              String?             @map("shift")
  // Existing rows (owners, and staff created the old direct way) default to approved — this
  // status only means something for a profile that actually went through the propose flow.
  approvalStatus     StaffApprovalStatus @default(approved) @map("approval_status")
  proposedBy         String?             @map("proposed_by") // the FMO/owner who filled the profile in
  approvalResolvedBy String?             @map("approval_resolved_by")
  approvalResolvedAt DateTime?           @map("approval_resolved_at")
  approvalNote       String?             @map("approval_note") // set on reject, optional on approve
  // §user request — "Remove" a staff member: soft-delete (cleaning records/audit log entries
  // still reference them by id) rather than a hard delete. Clears pinHash too, so login is
  // revoked immediately and the PIN becomes reusable by someone else at the same hotel.
  active             Boolean             @default(true) @map("is_active")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel?            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  moduleRoles  UserModuleRole[]
  sessions     Session[]

  @@map("users")
}

enum StaffApprovalStatus {
  pending
  approved
  rejected
}

model UserModuleRole {
  userId String     @map("user_id")
  module ModuleType
  role   String // 'owner' | 'manager' | 'front_desk' | 'housekeeping' — scoped to modules the org has enabled

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@map("user_module_roles")
}

// ── §5.1 Core grid (Channel Manager) ────────────────────────────────────────

model Hotel {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  name                String
  addressLine         String?  @map("address_line") // street address — added beyond MD spec's sketch, for Super Admin's hotel detail view
  apartmentOrFloor    String?  @map("apartment_or_floor")
  city                String?
  state               String?
  pincode             String?
  // Captured from the "List Your Property" map-pin step — the exact pin location, not just the
  // text address, since those can disagree (and real OTA listings/driving-directions want the pin).
  latitude            Float?
  longitude           Float?
  shortCode           String   @unique @map("short_code") // Hotel ID for PMS PIN login (§8.1)
  gstRegistration     String?  @map("gst_registration")
  dpdpConsentAt       DateTime? @map("dpdp_consent_at")
  expectedRoomCount   Int?     @map("expected_room_count")
  expectedStaffCount  Int?     @map("expected_staff_count")
  // "List Your Property" step 2 (Basic Info) — captured beyond MD spec's sketch, mirrors the OTA extranet listing flow.
  starRating              Int?     @map("star_rating")
  builtYear               Int?     @map("built_year")
  acceptingBookingsSince  Int?     @map("accepting_bookings_since")
  contactEmail            String?  @map("contact_email")
  contactMobile           String?  @map("contact_mobile")
  contactMobileIsWhatsapp Boolean  @default(false) @map("contact_mobile_is_whatsapp")
  contactLandline         String?  @map("contact_landline")
  // "List Your Property" step 4 (Policies).
  checkInTime             String?  @map("check_in_time") // "HH:mm" 24-hour
  checkOutTime            String?  @map("check_out_time")
  cancellationPolicy      CancellationPolicy? @map("cancellation_policy")
  allowUnmarriedCouples   Boolean? @map("allow_unmarried_couples")
  // "List Your Property" step 5 (Amenities) — property-wide facility tags, same fixed-catalog
  // array convention as RoomCategory.amenities above.
  amenities               String[] @default([])
  // "List Your Property" step 7 (Finance & Legal). Payout fields are captured now even though
  // no OTA payout integration is live yet (deferred per user) — collecting once at onboarding
  // beats re-interrupting the owner later.
  panNumber               String?  @map("pan_number")
  bankAccountHolderName   String?  @map("bank_account_holder_name")
  bankAccountNumber       String?  @map("bank_account_number")
  bankIfsc                String?  @map("bank_ifsc")
  // The sidebar's brand mark (§ user request — "rooms logo", professionalized) — a single
  // slot, not a gallery like HotelPhoto below, since a logo has exactly one current version.
  logoFilePath            String?  @map("logo_file_path")
  // §user request — a brand/property can set their own theme colour (e.g. Skymax's own logo
  // blue) and have it apply app-wide (headings, buttons, chart lines), instead of the app's
  // default indigo. A hex string; null means "use the default app colour". The frontend derives
  // the full 50/100/500/600/700 shade ramp from this one value at runtime via CSS custom
  // properties, so nothing server-side needs the derived shades.
  brandColor              String?  @map("brand_color")
  // §user request — simplified from an image upload to just text: the top header strip uses the
  // hotel's own brandColor as its background (no separate colour needed) with this text shown
  // boldly on it, e.g. "Skymax Hotel & BnB's". Null/empty means the header stays the plain bar.
  bannerText              String?  @map("banner_text")
  // §user request — "Font Setup (Adv feature)... by default jo font hai vahi rahega": one of a
  // fixed curated list of web-safe font stacks (brandFont.ts owns the list), applied app-wide the
  // same way brandColor is. Null means "use the app's current default font" — never a free-text
  // font name, so there's no risk of loading an arbitrary/unvetted font.
  fontFamily              String?  @map("font_family")
  // §user request — Invoice Settings: printed on the guest-facing tax invoice alongside the
  // existing gstRegistration/panNumber/bank* fields above. All optional — an invoice prints fine
  // with none of these set, it just omits that line.
  licenseNumber                String?  @map("license_number") // trade/FHRAI licence no., if the hotel has one
  upiId                        String?  @map("upi_id") // for a payment UPI ID line/QR on the invoice
  invoiceTerms                 String?  @map("invoice_terms")
  invoiceStampPath             String?  @map("invoice_stamp_path")
  showPaymentSummaryOnInvoice  Boolean  @default(false) @map("show_payment_summary_on_invoice")
  showTermsOnInvoice           Boolean  @default(false) @map("show_terms_on_invoice")
  // §user request — Ledger: a single lump-sum starting point, not per payment-mode (keeps this
  // simple — the per-mode breakdown the Ledger page shows is computed purely from transactions
  // dated after this, same as DigiStay's but without needing N separate opening values).
  ledgerOpeningBalance Decimal?  @map("ledger_opening_balance") @db.Decimal(10, 2)
  ledgerOpeningDate    DateTime? @map("ledger_opening_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomCategories  RoomCategory[]
  otaConnections  OtaConnection[]
  rooms           Room[]
  bookings        Booking[]
  ledgerCategories LedgerCategory[]
  ledgerEntries    LedgerEntry[]
  cleaningRecords CleaningRecord[]
  auditLogs       AuditLog[]
  loginAttempts   LoginAttempt[]
  pinStaff        User[]
  guests          Guest[]
  notifications   Notification[]
  guestMessages   GuestMessage[]
  roomBlocks      RoomBlock[]
  maintenanceBlocks RoomMaintenanceBlock[]
  dayNotes        DayNote[]
  photos          HotelPhoto[]
  reviews         Review[]
  contacts        HotelContact[]

  @@map("hotels")
}

model HotelPhoto {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  filePath  String   @map("file_path")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_photos")
}

// §user request — "hotel ke important contacts save kare, electrician/plumber ke 5-6 number,
// FMO add kar sake lekin sirf owner delete kar sake": a flat, hotel-scoped address book — not
// per-category records (an electrician isn't a structured entity elsewhere in this schema), just
// Name + a free-text Category label (so "Plumber", "Electrician", "AC Repair"... aren't a fixed
// enum the hotel is locked into) + Phone. Multiple rows can share a category on purpose (that's
// the "5-6 electricians" case) — nothing here assumes one contact per category.
model HotelContact {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  name      String
  category  String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_contacts")
}

model RoomCategory {
  id          String   @id @default(cuid())
  hotelId     String   @map("hotel_id")
  name        String
  description String?
  active      Boolean  @default(true)
  // Full room-detail page (§ user request, matching a reference OTA extranet's "Room Details" view).
  roomType      String?  @map("room_type") // e.g. Standard, Deluxe, Luxury, Suite
  roomView      String?  @map("room_view") // e.g. No View, City View, Pool View
  roomSizeSqft  Int?     @map("room_size_sqft")
  bedType       String?  @map("bed_type") // e.g. "1 King Bed", "2 Twin Beds"
  maxOccupancy  Int?     @map("max_occupancy")
  bathroomCount Int?     @map("bathroom_count")
  // A fixed-catalog multi-select tag set (not per-item metadata, unlike photos below) —
  // a native Postgres array column fits this better than a join table would.
  amenities     String[] @default([])

  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ratePlans RatePlan[]
  rooms     Room[]
  otaRoomMappings OtaRoomMapping[]
  roomBlocks RoomBlock[]
  dayNotes  DayNote[]
  photos    RoomPhoto[]

  @@map("room_categories")
}

model RoomPhoto {
  id             String   @id @default(cuid())
  roomCategoryId String   @map("room_category_id")
  filePath       String   @map("file_path")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)

  @@map("room_photos")
}

// Walk-in inventory holdback (§ user request) — a walk-in guest taken straight at the
// front desk has no OTA/CM reservation and deliberately gets no booking record with guest
// details here; this just pulls N rooms out of the shared pooled-availability count (same
// pool `RatesService.adjustAvailabilityForStay` already uses for real bookings) so other
// connected channels can't oversell rooms that are physically occupied.
model RoomBlock {
  id             String    @id @default(cuid())
  hotelId        String    @map("hotel_id")
  roomCategoryId String    @map("room_category_id")
  startDate      DateTime  @db.Date @map("start_date")
  endDate        DateTime  @db.Date @map("end_date") // exclusive, like booking checkOut
  roomsBlocked   Int       @map("rooms_blocked")
  reason         String?
  createdBy      String    @map("created_by")
  releasedAt     DateTime? @map("released_at")
  releasedBy     String?   @map("released_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)

  @@index([hotelId, roomCategoryId, startDate])
  @@map("room_blocks")
}

// §user request, matching a reference app's own "Create Maintenance Block" panel (Calendar's
// empty-cell click menu) — unlike RoomBlock above (a category + count held back from the pooled
// OTA count, no specific physical room), this is ONE SPECIFIC ROOM out of service for a real
// reason (repair, deep clean) over a real date+time range, independent of OTA inventory entirely.
model RoomMaintenanceBlock {
  id         String    @id @default(cuid())
  hotelId    String    @map("hotel_id")
  roomId     String    @map("room_id")
  startAt    DateTime  @map("start_at")
  endAt      DateTime  @map("end_at") // exclusive, like a booking's checkOut
  reason     String?
  createdBy  String    @map("created_by")
  releasedAt DateTime? @map("released_at")
  releasedBy String?   @map("released_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([hotelId, roomId, startAt])
  @@map("room_maintenance_blocks")
}

// A private staff-only note on one room category's one day (§ user request, matching a
// reference Calendar cell-editor) — guests never see this; it's scoped to the category+date,
// not any one channel, since it's about the physical day, not a specific OTA sync target.
model DayNote {
  id             String   @id @default(cuid())
  hotelId        String   @map("hotel_id")
  roomCategoryId String   @map("room_category_id")
  date           DateTime @db.Date
  note           String
  updatedBy      String   @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")

  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)

  @@unique([roomCategoryId, date])
  @@map("day_notes")
}

model RatePlan {
  id               String  @id @default(cuid())
  roomCategoryId   String  @map("room_category_id")
  name             String
  mealPlan         String? @map("meal_plan")
  isDerived        Boolean @default(false) @map("is_derived")
  baseRatePlanId   String? @map("base_rate_plan_id")
  formula          String? // computed at read time (§5.5) — e.g. "base + 500"

  roomCategory   RoomCategory     @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  baseRatePlan   RatePlan?        @relation("DerivedRatePlan", fields: [baseRatePlanId], references: [id])
  derivedPlans   RatePlan[]       @relation("DerivedRatePlan")
  inventoryRates InventoryRate[]
  restrictions   Restriction[]
  bookings       Booking[]

  @@map("rate_plans")
}

enum OtaCode {
  mmt_goibibo
  booking_com
  agoda
  cleartrip
  expedia
  airbnb
  easemytrip
  yatra
}

model OtaConnection {
  id            String   @id @default(cuid())
  hotelId       String   @map("hotel_id")
  otaCode       OtaCode  @map("ota_code")
  status        String   @default("pending") // 'pending' | 'connected' | 'error'
  credentialRef String?  @map("credential_ref") // points at the vault, never inline (§5.1)
  // channel economics (§6 Unified Ledger Dashboard: "store commission %
  // per channel even before this screen reads them") — used to derive
  // "payable to property" on the bookings table without a second accounting system.
  commissionRatePercent Decimal? @map("commission_rate_percent") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomMappings    OtaRoomMapping[]
  inventoryRates  InventoryRate[]
  restrictions    Restriction[]
  bookings        Booking[]
  credential      OtaCredential?
  apiLogs         OtaApiLog[]

  @@unique([hotelId, otaCode])
  @@map("ota_connections")
}

// Encrypted at rest (AES-256-GCM, CredentialVaultService) — never plaintext,
// never inline on OtaConnection itself (§3, §7 Phase 1 #13, §11's "never embed
// a password in anything client-readable" anti-pattern warning).
model OtaCredential {
  id              String   @id @default(cuid())
  otaConnectionId String   @unique @map("ota_connection_id")
  cipherText      String   @map("cipher_text")
  iv              String
  authTag         String   @map("auth_tag")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  otaConnection OtaConnection @relation(fields: [otaConnectionId], references: [id], onDelete: Cascade)

  @@map("ota_credentials")
}

// Every real adapter's raw request/response, per direct-ota-integration-guide.md
// §2.3: "OTA support always asks for exact payloads + timestamps." Card data
// never transits ARI calls, so nothing here needs masking — but this table is
// insert-only, same write-once discipline as cleaning photos, for the same
// audit-trail reason.
model OtaApiLog {
  id              String   @id @default(cuid())
  otaConnectionId String   @map("ota_connection_id")
  direction       String // 'outbound' | 'inbound'
  endpoint        String
  requestBody     String?  @map("request_body") @db.Text
  responseBody    String?  @map("response_body") @db.Text
  httpStatus      Int?     @map("http_status")
  latencyMs       Int?     @map("latency_ms")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  otaConnection OtaConnection @relation(fields: [otaConnectionId], references: [id], onDelete: Cascade)

  @@index([otaConnectionId, createdAt])
  @@map("ota_api_logs")
}

model OtaRoomMapping {
  id              String  @id @default(cuid())
  otaConnectionId String  @map("ota_connection_id")
  roomCategoryId  String  @map("room_category_id")
  otaRoomName     String  @map("ota_room_name") // free-text display label — always present, works for every OTA
  // A real adapter (e.g. Agoda's SetAriV2) pushes by the OTA's own room/rate
  // *code*, not a display name — nullable because stub-only OTAs (no public
  // API yet) have no code to fetch, only the human-entered name above.
  otaRoomCode     String? @map("ota_room_code")
  otaRatePlanCode String? @map("ota_rate_plan_code")

  otaConnection OtaConnection @relation(fields: [otaConnectionId], references: [id], onDelete: Cascade)
  roomCategory  RoomCategory  @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)

  @@unique([otaConnectionId, roomCategoryId])
  @@map("ota_room_mappings")
}

enum RateSource {
  bulk_update
  value_override
  ota_push
}

// the core grid: every screen reads/writes this
model InventoryRate {
  id               String     @id @default(cuid())
  ratePlanId       String     @map("rate_plan_id")
  otaConnectionId  String     @map("ota_connection_id")
  date             DateTime   @db.Date
  occupancyTier    Int        @map("occupancy_tier") // 1..4
  price            Decimal    @db.Decimal(10, 2)
  extraAdultPrice  Decimal?   @map("extra_adult_price") @db.Decimal(10, 2)
  child1Price      Decimal?   @map("child_1_price") @db.Decimal(10, 2)
  child2Price      Decimal?   @map("child_2_price") @db.Decimal(10, 2)
  availability     Int
  isDerivedValue   Boolean    @default(false) @map("is_derived_value")
  source           RateSource
  changedBy        String     @map("changed_by")
  changedAt        DateTime   @default(now()) @map("changed_at")

  ratePlan      RatePlan      @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  otaConnection OtaConnection @relation(fields: [otaConnectionId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, otaConnectionId, date, occupancyTier])
  @@index([ratePlanId, date])
  @@map("inventory_rates")
}

// restrictions are booleans/values, never a price of zero (§5.1)
model Restriction {
  id                String   @id @default(cuid())
  ratePlanId        String   @map("rate_plan_id")
  otaConnectionId   String   @map("ota_connection_id")
  date              DateTime @db.Date
  channelBlocked    Boolean  @default(false) @map("channel_blocked")
  ratePlanClosed    Boolean  @default(false) @map("rate_plan_closed")
  closedToArrival   Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean  @default(false) @map("closed_to_departure")
  minLos            Int?     @map("min_los")
  maxLos            Int?     @map("max_los")
  bookableNights    Int?     @map("bookable_nights")
  policyOverrideId  String?  @map("policy_override_id")
  minLosArrival     Int?     @map("min_los_arrival")
  maxLosArrival     Int?     @map("max_los_arrival")
  exactLosArrival   Int?     @map("exact_los_arrival")
  minAdvanceDays    Int?     @map("min_advance_days")
  maxAdvanceDays    Int?     @map("max_advance_days")
  cap               Int?     // Phase 3 — column exists from day one
  cutoffHours       Int?     @map("cutoff_hours") // Phase 3
  allocationCount   Int?     @map("allocation_count") // Phase 3

  ratePlan      RatePlan      @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  otaConnection OtaConnection @relation(fields: [otaConnectionId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, otaConnectionId, date])
  @@index([ratePlanId, date])
  @@map("restrictions")
}

// ── §5.2 Bookings & payments (shared by CM and PMS) ─────────────────────────

enum BookingStatus {
  confirmed // direct booking, not yet checked in (§8.4)
  checked_in
  checked_out
  cancelled
}

// added beyond the MD spec's schema sketch — guest ID capture at check-in (§8.3)
enum IdType {
  aadhaar
  passport
  driving_license
  voter_id
  other
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

// Reusable guest profile — added beyond the MD spec's schema sketch (which had
// no guest CRM concept, just guest_name/guest_phone inline on bookings).
// Searched by phone at check-in so a repeat guest's details autofill instead
// of being retyped. Hotel-scoped, not organization-wide — revisit if a chain
// wants guest history shared across properties.
model Guest {
  id          String    @id @default(cuid())
  hotelId     String    @map("hotel_id")
  title       String?
  name        String
  phone       String
  email       String?
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  address     String?
  country     String?   @default("India")
  state       String?
  city        String?
  pincode     String?
  idType      IdType?   @map("id_type")
  idNumber    String?   @map("id_number")
  idPhotoPath String?   @map("id_photo_path") // local disk path (dev) — would move to S3 in production per §3
  // §user request — "aadhaar front and back dono upload, AI dono se details padhe (address
  // khaas kar back side se)": idPhotoPath above now means "front"; this is the second side.
  idPhotoBackPath String? @map("id_photo_back_path")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hotelId, phone])
  @@map("guests")
}

enum BookingSource {
  mmt_goibibo
  booking_com
  agoda
  cleartrip
  expedia
  airbnb
  easemytrip
  yatra
  direct // manual/future-dated entry, §8.4
  walk_in // checked in on the spot, §8.3
}

model Booking {
  id               String        @id @default(cuid())
  hotelId          String        @map("hotel_id")
  otaConnectionId  String?       @map("ota_connection_id")
  otaBookingRef    String?       @map("ota_booking_ref")
  guestName        String        @map("guest_name")
  guestPhone       String?       @map("guest_phone")
  // captured at check-in (§8.3) — common regulatory requirement at Indian
  // hotels. Stored in plaintext for now, same as guest name/phone; no
  // field-level encryption yet despite being sensitive under DPDP (§11) —
  // flagged as a real gap, not an oversight, if this needs hardening later.
  idType           IdType?       @map("id_type")
  idNumber         String?       @map("id_number")
  // links to the reusable profile this snapshot was taken from (nullable —
  // OTA-sourced bookings, and bookings made before Guest existed, have none)
  guestId          String?       @map("guest_id")
  purposeOfStay    String?       @map("purpose_of_stay")
  // §user request — a reference app's multi-room Create Reservation flow: one umbrella
  // reservation (shared guest/dates) can book several specific rooms at once, each its own
  // Booking row (own status, own check-in, own payments) sharing this id. Null for the
  // ordinary single-room case — nothing about the existing flow changes for those.
  reservationGroupId String?     @map("reservation_group_id")
  // §user request — "Neeraj ji ne booking karvayi hai, Room 102 mein koi aur guest aa raha hai":
  // a multi-room reservation is made by one booker (e.g. a travel agent or corporate contact)
  // on behalf of several actual occupants — one per room, each named separately at that room's
  // own check-in. `guestName` above becomes that specific room's actual guest once checked in,
  // which would otherwise lose who originally placed the booking — this preserves it. Set once
  // at creation (createMultiRoomReservation), never touched again; null for an ordinary
  // single-room booking where the booker and the guest are the same person.
  bookedByName     String?       @map("booked_by_name")
  // §user request — the group reservation's own summary ("Booking Details: Neeraj Gupta,
  // <phone>") needs the booker's contact too, same staleness risk as bookedByName: guestPhone
  // gets overwritten per-room at that room's own check-in.
  bookedByPhone    String?       @map("booked_by_phone")
  guestEmail       String?       @map("guest_email")
  specialRequest   String?       @map("special_request")
  roomCategoryId   String        @map("room_category_id")
  ratePlanId       String?       @map("rate_plan_id")
  // set at check-in (§8.3); unlike rooms.current_stay_id (cleared on checkout), this
  // persists so a completed stay can still be reported "per room" (§8.8) — added
  // beyond the MD spec's schema sketch, which had no way to answer that after checkout.
  assignedRoomId   String?       @map("assigned_room_id")
  checkIn          DateTime      @map("check_in") @db.Date
  checkOut         DateTime      @map("check_out") @db.Date
  nights           Int
  status           BookingStatus @default(confirmed)
  source           BookingSource
  paidAmount       Decimal?      @map("paid_amount") @db.Decimal(10, 2) // null = predates payment tracking, not "unpaid"
  paymentMethod    String?       @map("payment_method") // first method recorded, headline only
  delayResolvedAt  DateTime?     @map("delay_resolved_at")
  delayResolvedBy  String?       @map("delay_resolved_by")
  delayResolvedNote String?      @map("delay_resolved_note")
  totalAmount      Decimal       @map("total_amount") @db.Decimal(10, 2) // base room charge — the payable grand total also includes lineItems and subtracts discountAmount, see common/invoice.ts
  discountAmount   Decimal?      @map("discount_amount") @db.Decimal(10, 2) // added beyond MD spec — flat discount off the grand total
  gstExempt        Boolean       @default(false) @map("gst_exempt") // added beyond MD spec — bypasses the §5.1 GST slab entirely when true
  // set the moment status becomes checked_in (both walk-in and reservation
  // check-in) — the basis for the 1-hour post-check-in edit window (§ added
  // beyond MD spec, at user request). Distinct from `createdAt`: for a
  // reservation checked in days after it was created, createdAt is stale.
  checkedInAt      DateTime?     @map("checked_in_at")
  // §user request — a real "Check-out Guest" step the FMO/GM must take; the room only
  // becomes Housekeeping-pending from this, never implicitly from a cleaning submission.
  checkedOutAt     DateTime?     @map("checked_out_at")
  checkedOutBy     String?       @map("checked_out_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  // The channel's own voucher/payout breakdown — shape varies per channel (MMT shows
  // commission+GST+TCS+TDS, Airbnb shows host service fee, Booking.com shows estimated
  // commission, direct/walk-in have none) so this is stored as-is rather than forced into
  // rigid columns, and rendered generically in the booking detail view (§ user request:
  // "saari cheezein voucher se extract karke dikhao").
  otaCancellationPolicy String? @map("ota_cancellation_policy")
  channelBreakdown       Json?  @map("channel_breakdown")
  // §user request — "company ki name se GST invoice banana ho toh company info daal ke ban
  // jaaye": a corporate guest's invoice needs to be billed to their employer (for GST input
  // credit), not the individual — set from the invoice print view itself, right before
  // printing, rather than captured upfront at check-in (not every booking needs it, and it's
  // often decided only when the invoice is actually requested). Null = bill to the guest
  // (unchanged, existing behaviour); set = invoice's "Billed to" switches to the company.
  billToCompanyName    String? @map("bill_to_company_name")
  // §user request — "Tax ID Type" dropdown (GSTIN/PAN/Other) alongside the number itself, instead
  // of assuming every company's tax ID is a GSTIN.
  billToCompanyTaxIdType String? @map("bill_to_company_tax_id_type")
  billToCompanyGstin   String? @map("bill_to_company_gstin")
  billToCompanyPhone   String? @map("bill_to_company_phone")
  billToCompanyEmail   String? @map("bill_to_company_email")
  billToCompanyAddress String? @map("bill_to_company_address")
  billToCompanyCountry String? @map("bill_to_company_country")
  billToCompanyState   String? @map("bill_to_company_state")
  billToCompanyCity    String? @map("bill_to_company_city")
  billToCompanyPincode String? @map("bill_to_company_pincode")

  hotel         Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  otaConnection OtaConnection? @relation(fields: [otaConnectionId], references: [id])
  ratePlan      RatePlan?      @relation(fields: [ratePlanId], references: [id])
  guest         Guest?         @relation(fields: [guestId], references: [id])
  payments      Payment[]
  lineItems     InvoiceLineItem[]
  guests        BookingGuest[]
  room          Room?          @relation("CurrentStay")
  assignedRoom  Room?          @relation("AssignedRoom", fields: [assignedRoomId], references: [id])
  guestMessages GuestMessage[]
  reviews       Review[]

  @@index([hotelId, checkIn])
  @@index([hotelId, status])
  @@index([hotelId, reservationGroupId])
  @@map("bookings")
}

// Guest Messaging — a unified inbox across OTA channels (§ user request, added
// beyond the MD spec's sketch). No real OTA messaging-API integration exists yet
// (same "simulate first, wire up the real channel later" posture as the rest of
// this build), so a message is either typed by staff or logged by staff on the
// guest's behalf (e.g. a call/WhatsApp message relayed manually) — `sender`
// records which side of the conversation it represents either way.
enum MessageSender {
  guest
  staff
}

model GuestMessage {
  id          String        @id @default(cuid())
  hotelId     String        @map("hotel_id")
  bookingId   String        @map("booking_id")
  sender      MessageSender
  body        String
  readByStaff Boolean       @default(false) @map("read_by_staff")
  createdAt   DateTime      @default(now()) @map("created_at")

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([hotelId, bookingId])
  @@index([hotelId, createdAt])
  @@map("guest_messages")
}

// OTA Reviews (§ user request) — same "simulate first, wire up the real channel later"
// posture as Guest Messaging above: no live OTA review-pull API exists yet, so an
// owner/manager logs what they saw on that OTA's own extranet. Deliberately tied to a real
// Booking (not a free-text guest name) so every review can always jump straight into that
// guest's Guest Messaging thread — the whole point of the "Message" action on this screen.
model Review {
  id         String   @id @default(cuid())
  hotelId    String   @map("hotel_id")
  bookingId  String   @map("booking_id")
  source     BookingSource
  rating     Decimal  @db.Decimal(3, 1) // the raw score as shown on that OTA, e.g. 8.5
  maxRating  Int      @default(10) @map("max_rating") // OTAs differ: Booking.com/Agoda are /10, Airbnb/MMT are usually /5
  reviewText String?  @map("review_text")
  reviewDate DateTime @map("review_date") @db.Date // when the OTA posted it, not when it was logged here
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([hotelId, reviewDate])
  @@map("reviews")
}

// expanded beyond the MD spec's cash/online/card sketch — real methods this
// product's hotels use (§ user request, matching a reference competitor UI)
enum PaymentMethod {
  cash
  online
  card
  bank_transfer
  company_settlement
  agent_settlement
  upi
  credit_sale
  cheque
  cash_deposit
}

// one row per actual payment collection — the ledger behind bookings.paid_amount's running total
model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @map("booking_id")
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  referenceNumber String?      @map("reference_number") // transaction/cheque/UPI ref — added beyond MD spec
  receiptPhotoPath String?     @map("receipt_photo_path") // dev-local disk path, same pattern as Guest.idPhotoPath
  collectedBy    String        @map("collected_by")
  collectedAt    DateTime      @default(now()) @map("collected_at") // client-settable at entry time (backdated collections), defaults to now

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// §user request — "Ledger / Chart of Accounts": the hotel's own cash movements (utility bills,
// payroll, supplies) that aren't guest payments — those already live in Payment above and are
// merged into the Ledger page's transaction list at read time (tagged "Room"), not duplicated
// into rows here. Petty cash is just a tag (isPettyCash), not a separate fund/table — a Cash In
// still raises the main balance, it also counts toward the petty-cash sub-total the UI shows.
enum LedgerEntryType {
  cash_in
  cash_out
}

model LedgerCategory {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  name      String
  parentId  String?  @map("parent_id") // null = top-level category, set = a subcategory under it
  createdAt DateTime @default(now()) @map("created_at")

  hotel    Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  parent   LedgerCategory?  @relation("LedgerCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children LedgerCategory[] @relation("LedgerCategoryChildren")
  entries  LedgerEntry[]

  @@map("ledger_categories")
}

model LedgerEntry {
  id            String          @id @default(cuid())
  hotelId       String          @map("hotel_id")
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod   @map("payment_method")
  categoryId    String?         @map("category_id")
  remarks       String?
  isPettyCash   Boolean         @default(false) @map("is_petty_cash")
  createdBy     String          @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")

  hotel    Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category LedgerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@map("ledger_entries")
}

// "Add Extra Charges" on the invoice (extra bed, food, laundry, damage, etc.) —
// added beyond the MD spec, which only priced the room itself via inventory_rates.
model InvoiceLineItem {
  id          String   @id @default(cuid())
  bookingId   String   @map("booking_id")
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2) // quantity * unitPrice, stored (not recomputed) so a later unitPrice edit never silently changes a past invoice line
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// A co-occupant on an existing booking — "add another guest" (§ added beyond
// MD spec, user request). No separate room or payment; just another name/ID
// recorded against the same stay. Reuses the same guest-detail shape as the
// primary guest, but deliberately its own row rather than a second Booking —
// this person didn't book a room, they're sharing one.
model BookingGuest {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  title     String?
  name      String
  phone     String?
  idType    IdType?  @map("id_type")
  idNumber  String?  @map("id_number")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_guests")
}

// ── §5.3 PMS: physical rooms, housekeeping ──────────────────────────────────

enum RoomStatus {
  available
  occupied
  housekeeping
}

enum CancellationPolicy {
  free_till_checkin
  free_24h
  free_48h
  free_72h
  non_refundable
}

model Room {
  id              String     @id @default(cuid())
  hotelId         String     @map("hotel_id")
  roomCategoryId  String?    @map("room_category_id") // null until the owner sorts it during onboarding (§8.2 step 2)
  roomNumber      String     @map("room_number")
  status          RoomStatus @default(available)
  currentStayId   String?    @unique @map("current_stay_id") // null unless occupied by an active stay
  statusChangedAt DateTime   @default(now()) @map("status_changed_at")
  active          Boolean    @default(true) // soft-delete

  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomCategory   RoomCategory?    @relation(fields: [roomCategoryId], references: [id])
  currentStay    Booking?         @relation("CurrentStay", fields: [currentStayId], references: [id])
  cleaningRecords CleaningRecord[]
  assignedBookings Booking[]      @relation("AssignedRoom")
  maintenanceBlocks RoomMaintenanceBlock[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

enum CleaningKind {
  checkout
  guest_stay
}

// storage: insert-only, no update/delete — evidence is write-once (§8.6)
model CleaningRecord {
  id                    String       @id @default(cuid())
  hotelId               String       @map("hotel_id")
  roomId                String       @map("room_id")
  stayId                String?      @map("stay_id")
  kind                  CleaningKind
  primaryHousekeeperId  String       @map("primary_housekeeper_id")
  secondHousekeeperId   String?      @map("second_housekeeper_id")
  photos                Json         @default("[]") // jsonb array of storage paths
  flagged               Boolean      @default(false) // true if submitted with no active stay — a discrepancy
  resolvedAt            DateTime?    @map("resolved_at")
  resolvedBy            String?      @map("resolved_by")
  resolvedNote          String?      @map("resolved_note")
  createdAt             DateTime     @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("cleaning_records")
}

// ── §5.3 Cross-module audit log ─────────────────────────────────────────────

enum AuditEventType {
  CHECK_IN
  PAYMENT_RECEIVED
  CLEANING_SUBMITTED
  CLEANING_FLAGGED
  DISCREPANCY_RESOLVED
  STAY_EDITED
  ROOM_CHANGED
  GUEST_CLEANING
  MANUAL_BLOCK
  UNRECORDED_OCCUPANCY_FLAGGED
  SYNC_FAILED // added beyond the MD spec's list — OTA push exhausted retries (§7 Phase 1 #10, §2)
  DELAY_RESOLVED // added beyond the MD spec's list — §8.7's "Delayed" state resolved by an owner/manager
  // Channel Manager's own audit trail (Phase 2's "Audit logs screen" — §7) — a bulk/override write
  // already carries its own source/changed_by on inventory_rates itself (§5.1), but these are the
  // actions with no other durable record anywhere: restriction rules, room mapping, connection
  // setup, and credentials being touched at all (never the credential values themselves).
  RATE_BULK_UPDATE
  RATE_VALUE_OVERRIDE
  RESTRICTION_UPDATED
  ROOM_MAPPING_UPDATED
  CREDENTIALS_UPDATED
  CHANNEL_CONNECTED
  // §user request — staff profile + approval workflow (a GM/FMO proposes, only an owner
  // approves/rejects and mints the PIN).
  STAFF_PROPOSED
  STAFF_APPROVED
  STAFF_REJECTED
  STAFF_PIN_SET
  STAFF_REMOVED
  CHECK_OUT // §user request — FMO/GM explicit "Check-out Guest" step, distinct from housekeeping's cleaning submission
  RESERVATION_CREATED // §user request — a multi-room reservation created with specific rooms picked upfront
}

model AuditLog {
  id        String         @id @default(cuid())
  hotelId   String         @map("hotel_id")
  eventType AuditEventType @map("event_type")
  actorId   String         @map("actor_id")
  subjectId String?        @map("subject_id")
  detail    Json?
  createdAt DateTime       @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
  @@map("audit_log")
}

// In-app alerts (§7 Phase 1 #10/#11) — the interim alert surface until mobile
// push exists (Expo push per §3/§9.2 needs a mobile client to send to).
enum NotificationType {
  sync_failed
  booking_created
  booking_cancelled
  staff_pending_approval // §user request — a GM/FMO proposed a staff profile; owner needs to review it
  room_auto_checked_out // legacy — pre-dates the explicit FMO Check-out Guest step, kept for historical rows; no longer fired
  cleaning_discrepancy // §user request — housekeeping cleaned a room with no matching FMO check-out on record; owner needs to review it
}

model Notification {
  id        String           @id @default(cuid())
  hotelId   String           @map("hotel_id")
  type      NotificationType
  title     String
  body      String
  link      String? // deep-link within the web app, e.g. a tab name
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, read, createdAt])
  @@map("notifications")
}

// ── §5.3 Sessions & PIN login lockouts ───────────────────────────────────────

model Session {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id") // null for PMS PIN sessions not tied to a `users` row
  platformAdminId String?  @map("platform_admin_id") // exactly one of these three is set per session, never more than one
  affiliateId     String?  @map("affiliate_id")
  token           String   @unique
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  affiliate     Affiliate?     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// keyed on (device_id, hotel_short_code) for PMS PIN lockouts (§5.3)
model LoginAttempt {
  id         String   @id @default(cuid())
  hotelId    String   @map("hotel_id")
  deviceId   String   @map("device_id")
  succeeded  Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, deviceId, attemptedAt])
  @@map("login_attempts")
}
